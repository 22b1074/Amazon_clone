<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Create Account' }) %>
</head>
<body>
  <%- include('partials/header') %>

  <main id="main">
    <div class="auth">
      <div class="auth__media">
        <%- catalog.sceneArt('clay', 2, 'portrait') %>
        <p class="auth__quote">&ldquo;We make a small number of pieces each year, and we make them properly.&rdquo;</p>
      </div>

      <div class="auth__panel">
        <div class="auth__form">
          <span class="eyebrow">Join us</span>
          <h1 class="h2">Create an account</h1>
          <p class="lede">Save pieces, track orders, and hear first when something new is finished.</p>

          <form action="/signup" method="POST">
            <label class="field">
              <span class="field__label">Name</span>
              <input class="input" type="text" name="username" autocomplete="name" required>
            </label>

            <label class="field">
              <span class="field__label">Email address</span>
              <input class="input" type="email" name="email" autocomplete="email" required>
            </label>

            <label class="field">
              <span class="field__label">Password</span>
              <input class="input" type="password" name="password" autocomplete="new-password" minlength="8" required>
              <span class="tiny muted" style="display:block;margin-top:0.5rem">At least 8 characters.</span>
            </label>

            <button class="btn btn--primary btn--block btn--lg" type="submit">Create Account</button>
          </form>

          <p class="auth__alt">Already have an account? <a href="/login">Sign in</a></p>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>

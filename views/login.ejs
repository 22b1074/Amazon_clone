<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Sign In' }) %>
</head>
<body>
  <%- include('partials/header') %>

  <main id="main">
    <div class="auth">
      <div class="auth__media">
        <%- catalog.sceneArt('sage', 1, 'portrait') %>
        <p class="auth__quote">&ldquo;The things you keep longest are rarely the ones you thought about hardest.&rdquo;</p>
      </div>

      <div class="auth__panel">
        <div class="auth__form">
          <span class="eyebrow">Welcome back</span>
          <h1 class="h2">Sign in</h1>
          <p class="lede">Your cart, your wishlist, and your order history, all where you left them.</p>

          <form action="/login" method="POST">
            <label class="field">
              <span class="field__label">Email address</span>
              <input class="input" type="email" name="email" autocomplete="email" required>
            </label>

            <label class="field">
              <span class="field__label">Password</span>
              <input class="input" type="password" name="password" autocomplete="current-password" required>
            </label>

            <button class="btn btn--primary btn--block btn--lg" type="submit">Sign In</button>
          </form>

          <p class="auth__alt">New to <%= catalog.brand.name %>? <a href="/signup">Create an account</a></p>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>

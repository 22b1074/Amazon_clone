<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Wishlist' }) %>
</head>
<body>
  <%- include('partials/header') %>

  <main id="main">
    <section class="page-head">
      <div class="wrap-wide">
        <nav class="crumbs reveal" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><span>Wishlist</span>
        </nav>
        <span class="eyebrow reveal">Saved</span>
        <h1 class="h1 reveal" data-delay="1">Your wishlist</h1>
        <p class="lede reveal" data-delay="2">
          Pieces you have set aside. Saved to this browser. Sign in and add them to your cart when you are ready.
        </p>
      </div>
    </section>

    <section class="section section--tight">
      <div class="wrap-wide">
        <div class="product-grid" data-wishlist-grid hidden>
          <% products.forEach(function (product, i) { %>
            <%- include('partials/product-card', { product: product, delay: Math.min(i % 4 + 1, 4) }) %>
          <% }) %>
        </div>

        <div class="notice" data-wishlist-empty>
          <div class="notice__inner">
            <div class="notice__icon">
              <svg width="26" height="26" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
                <path d="M10 16.5S3 12.6 3 7.9A3.9 3.9 0 0 1 10 5.6a3.9 3.9 0 0 1 7 2.3c0 4.7-7 8.6-7 8.6z" stroke-linejoin="round"/>
              </svg>
            </div>
            <h2 class="h2">Nothing saved yet</h2>
            <p class="lede">Tap the heart on any piece to keep it here while you decide.</p>
            <div class="notice__actions">
              <a class="btn btn--primary" href="/shop">Browse the collection</a>
              <a class="btn btn--ghost" href="/new-arrivals">See what's new</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>

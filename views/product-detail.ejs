<%
  // Variant axes are presentation-only. The schema has no variants table.
  var variantSets = {
    Apparel:    { label: 'Size',   options: ['XS', 'S', 'M', 'L', 'XL'], active: 2 },
    Footwear:   { label: 'Size',   options: ['39', '40', '41', '42', '43', '44'], active: 2 },
    Beauty:     { label: 'Shade',  options: ['Dune', 'Clay', 'Rosewood', 'Ash'], active: 0 },
    Living:     { label: 'Finish', options: ['Natural Oak', 'Smoked Oak', 'Ash'], active: 0 },
    Appliances: { label: 'Finish', options: ['Graphite', 'Ivory', 'Steel'], active: 0 },
    Technology: { label: 'Storage',options: ['256GB', '512GB', '1TB'], active: 0 },
    Library:    { label: 'Edition',options: ['Paperback', 'Clothbound'], active: 0 },
    Sport:      { label: 'Grip',   options: ['L2', 'L3', 'L4'], active: 1 },
    Play:       { label: 'Variant',options: ['Natural', 'Sage', 'Clay'], active: 0 },
    Pantry:     { label: 'Size',   options: ['500g', '1kg', '5kg'], active: 1 }
  };
  var variantSet = variantSets[product.category];

  // Deterministic sample reviews, seeded from product_id.
  var reviewPool = [
    { by: 'Marta L.', place: 'Lisbon',    text: 'Arrived beautifully wrapped and somehow better in person. The finish has that soft, unlacquered quality you rarely see at this price.' },
    { by: 'Jonas W.', place: 'Berlin',    text: 'Six months of daily use and it has aged exactly the way they said it would. No complaints at all.' },
    { by: 'Priya R.', place: 'Mumbai',    text: 'I hesitated at the price and then stopped thinking about it the day it arrived. Quietly excellent.' },
    { by: 'Alix D.',  place: 'Montreal',  text: 'Understated in the best sense. It fits the room without demanding anything from it.' },
    { by: 'Sofia B.', place: 'Copenhagen',text: 'Third piece from ÉCRU and the consistency is what keeps me here. Packaging is plastic-free too.' }
  ];
  var reviewCount = 3;
  var shownReviews = [];
  for (var ri = 0; ri < reviewCount; ri++) {
    shownReviews.push(reviewPool[(product.id * 3 + ri) % reviewPool.length]);
  }
  var ratingBreakdown = [
    { stars: 5, pct: 78 }, { stars: 4, pct: 15 }, { stars: 3, pct: 5 }, { stars: 2, pct: 1 }, { stars: 1, pct: 1 }
  ];
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: product.title, description: product.story }) %>
</head>
<body>
  <%- include('partials/header') %>

  <main id="main">
    <div class="wrap-wide" style="padding-top:2.5rem">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <a href="/shop">Shop</a><span aria-hidden="true">/</span>
        <a href="/shop?category=<%= product.categorySlug %>"><%= product.category %></a><span aria-hidden="true">/</span>
        <span><%= product.title %></span>
      </nav>
    </div>

    <section class="section section--tight" style="padding-top:1rem">
      <div class="wrap-wide pdp">

        <!-- ─── Gallery ─────────────────────────────────────────────── -->
        <div class="gallery">
          <div class="gallery__main" data-gallery-main>
            <%- catalog.productArt(product, { ratio: 'portrait' }) %>
          </div>
          <div class="gallery__thumbs" role="tablist" aria-label="Product images">
            <% [0, 1, 2, 3].forEach(function (n) { %>
              <button class="gallery__thumb <%= n === 0 ? 'is-active' : '' %>" type="button" role="tab"
                      data-gallery-thumb aria-selected="<%= n === 0 %>"
                      aria-label="View image <%= n + 1 %>">
                <%- catalog.productArt(product, { ratio: 'portrait', seedOffset: n * 7 }) %>
              </button>
            <% }) %>
          </div>
        </div>

        <!-- ─── Purchase panel ──────────────────────────────────────── -->
        <div class="pdp__info">
          <span class="pdp__cat"><%= product.collection.name %> · <%= product.category %></span>
          <h1 class="h1 pdp__title"><%= product.title %></h1>
          <p class="pdp__sub"><%= product.sub %></p>

          <div class="pdp__meta">
            <span class="pdp__price">$<%= product.priceLabel %></span>
            <span class="rating">
              <svg width="14" height="14" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                <path d="M6 .8l1.6 3.3 3.6.5-2.6 2.5.6 3.6L6 9l-3.2 1.7.6-3.6L.8 4.6l3.6-.5z"/>
              </svg>
              <%= product.rating.toFixed(1) %> · <a href="#reviews" style="text-decoration:underline;text-underline-offset:3px"><%= product.reviews %> reviews</a>
            </span>
          </div>

          <p class="pdp__story"><%= product.story %></p>

          <% if (variantSet) { %>
            <div class="variants">
              <div class="variants__label">
                <span><%= variantSet.label %></span>
                <span class="muted" data-variant-value><%= variantSet.options[variantSet.active] %></span>
              </div>
              <div class="variants__row" data-variant-group role="radiogroup" aria-label="<%= variantSet.label %>">
                <% variantSet.options.forEach(function (opt, oi) { %>
                  <button class="variant <%= oi === variantSet.active ? 'is-active' : '' %>" type="button"
                          role="radio" aria-checked="<%= oi === variantSet.active %>" data-value="<%= opt %>"><%= opt %></button>
                <% }) %>
              </div>
            </div>
          <% } %>

          <div data-buy-anchor>
            <% if (product.inStock) { %>
              <form action="/add-to-cart" method="POST" data-cart-form>
                <input type="hidden" name="product_id" value="<%= product.id %>">

                <div class="variants__label" style="margin-bottom:0.75rem"><span>Quantity</span></div>
                <div class="buy-row">
                  <div class="qty">
                    <button class="qty__btn" type="button" data-step="down" aria-label="Decrease quantity">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 6h8" stroke-linecap="round"/></svg>
                    </button>
                    <label class="visually-hidden" for="quantity">Quantity</label>
                    <input class="qty__input" type="number" id="quantity" name="quantity"
                           value="1" min="1" max="<%= product.stock %>" required>
                    <button class="qty__btn" type="button" data-step="up" aria-label="Increase quantity">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6 2v8M2 6h8" stroke-linecap="round"/></svg>
                    </button>
                  </div>

                  <% if (session && session.userId) { %>
                    <button class="btn btn--primary btn--lg" type="submit">Add to Cart</button>
                  <% } else { %>
                    <a class="btn btn--primary btn--lg" href="/login" style="flex:1 1 12rem">Sign in to Purchase</a>
                  <% } %>

                  <button class="wish wish--static" type="button" data-wish="<%= product.id %>" aria-pressed="false">
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4">
                      <path d="M10 16.5S3 12.6 3 7.9A3.9 3.9 0 0 1 10 5.6a3.9 3.9 0 0 1 7 2.3c0 4.7-7 8.6-7 8.6z" stroke-linejoin="round"/>
                    </svg>
                    <span class="visually-hidden">Add to wishlist</span>
                  </button>
                </div>
              </form>

              <p class="stock-pill" style="margin-bottom:1.5rem">
                <% if (product.lowStock) { %>Low stock, only <%= product.stock %> remaining<% } else { %>In stock, ready to ship<% } %>
              </p>
            <% } else { %>
              <div class="buy-row">
                <span class="btn btn--ghost btn--lg" aria-disabled="true" style="flex:1">Sold Out</span>
                <button class="wish wish--static" type="button" data-wish="<%= product.id %>" aria-pressed="false">
                  <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4">
                    <path d="M10 16.5S3 12.6 3 7.9A3.9 3.9 0 0 1 10 5.6a3.9 3.9 0 0 1 7 2.3c0 4.7-7 8.6-7 8.6z" stroke-linejoin="round"/>
                  </svg>
                  <span class="visually-hidden">Add to wishlist</span>
                </button>
              </div>
              <p class="stock-pill stock-pill--out" style="margin-bottom:1.5rem">Currently unavailable</p>
            <% } %>
          </div>

          <div class="assurances">
            <p class="assurance">
              <svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 7h11v7H2z"/><path d="M13 9h3l2 2.5V14h-5z"/><circle cx="5.5" cy="15" r="1.6"/><circle cx="14.5" cy="15" r="1.6"/></svg>
              Complimentary delivery on orders over $150
            </p>
            <p class="assurance">
              <svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 10a7 7 0 1 1 2.5 5.4" stroke-linecap="round"/><path d="M3 6v4h4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              30-day returns, no questions asked
            </p>
            <p class="assurance">
              <svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M10 2.5l6 2.5v5c0 3.6-2.5 6.6-6 7.5-3.5-.9-6-3.9-6-7.5V5z" stroke-linejoin="round"/><path d="M7.5 10l1.8 1.8L13 8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Two-year guarantee on every piece
            </p>
          </div>

          <!-- ─── Details accordion ─────────────────────────────────── -->
          <div class="accordion">
            <div class="accordion__item">
              <button class="accordion__btn" type="button" aria-expanded="true" aria-controls="acc-details">
                Details &amp; Materials <span class="accordion__icon" aria-hidden="true"></span>
              </button>
              <div class="accordion__panel is-open" id="acc-details">
                <div>
                  <ul>
                    <li><strong>Materials:</strong> <%= product.material %></li>
                    <li><strong>Collection:</strong> <%= product.collection.name %>, <%= product.collection.subtitle %></li>
                    <li><strong>Reference:</strong> No. <%= String(product.id).padStart(4, '0') %></li>
                    <li><strong>Care:</strong> <%= product.care %></li>
                  </ul>
                </div>
              </div>
            </div>

            <div class="accordion__item">
              <button class="accordion__btn" type="button" aria-expanded="false" aria-controls="acc-shipping">
                Shipping &amp; Returns <span class="accordion__icon" aria-hidden="true"></span>
              </button>
              <div class="accordion__panel" id="acc-shipping">
                <div>
                  <p>
                    Dispatched within two working days. Standard delivery takes 3 to 5 days and is complimentary
                    over $150; express is available at checkout. Larger pieces are delivered by appointment.
                  </p>
                  <p>
                    Return anything unused within 30 days for a full refund. We cover the return postage
                    and reuse the original packaging wherever we can.
                  </p>
                </div>
              </div>
            </div>

            <div class="accordion__item">
              <button class="accordion__btn" type="button" aria-expanded="false" aria-controls="acc-craft">
                How it is made <span class="accordion__icon" aria-hidden="true"></span>
              </button>
              <div class="accordion__panel" id="acc-craft">
                <div>
                  <p>
                    Produced in small batches by a workshop we have worked with for years. Every piece is
                    checked by hand before it leaves, and each carries a reference number so it can be
                    repaired or replaced part-by-part rather than thrown away.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Reviews ───────────────────────────────────────────────────── -->
    <section class="section section--cream" id="reviews">
      <div class="wrap">
        <div class="section-head reveal">
          <div class="section-head__text">
            <span class="eyebrow">Reviews</span>
            <h2 class="h2">What owners say</h2>
          </div>
        </div>

        <div class="score-summary reveal" style="margin-bottom:3rem">
          <div>
            <div class="score-summary__n"><%= product.rating.toFixed(1) %></div>
            <div class="quote__stars" style="margin:0.5rem 0 0">
              <% for (var s = 0; s < 5; s++) { %>
                <svg width="14" height="14" viewBox="0 0 12 12" fill="<%= s < Math.round(product.rating) ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="0.8" aria-hidden="true">
                  <path d="M6 .8l1.6 3.3 3.6.5-2.6 2.5.6 3.6L6 9l-3.2 1.7.6-3.6L.8 4.6l3.6-.5z"/>
                </svg>
              <% } %>
            </div>
            <p class="tiny muted" style="margin-top:0.5rem"><%= product.reviews %> verified reviews</p>
          </div>
          <div style="flex:1;min-width:200px;display:grid;gap:0.4rem">
            <% ratingBreakdown.forEach(function (row) { %>
              <div style="display:flex;align-items:center;gap:0.75rem;font-size:0.8125rem;color:var(--ink-2)">
                <span style="width:2.5rem"><%= row.stars %> star</span>
                <span style="flex:1;height:4px;background:var(--sand);border-radius:2px;overflow:hidden">
                  <span style="display:block;height:100%;width:<%= row.pct %>%;background:var(--sage-deep)"></span>
                </span>
                <span style="width:2.5rem;text-align:right"><%= row.pct %>%</span>
              </div>
            <% }) %>
          </div>
        </div>

        <div class="reviews">
          <% shownReviews.forEach(function (r, i) { %>
            <article class="review reveal" data-delay="<%= i + 1 %>">
              <div class="review__head">
                <div class="quote__stars" style="margin:0">
                  <% for (var s = 0; s < 5; s++) { %>
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                      <path d="M6 .8l1.6 3.3 3.6.5-2.6 2.5.6 3.6L6 9l-3.2 1.7.6-3.6L.8 4.6l3.6-.5z"/>
                    </svg>
                  <% } %>
                </div>
                <span class="review__by"><%= r.by %> · <%= r.place %> · Verified</span>
              </div>
              <p class="review__text"><%= r.text %></p>
            </article>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ─── Recommended ───────────────────────────────────────────────── -->
    <% if (relatedProducts.length) { %>
      <section class="section">
        <div class="wrap-wide">
          <div class="section-head reveal">
            <div class="section-head__text">
              <span class="eyebrow">You may also like</span>
              <h2 class="h2">Pairs well with</h2>
            </div>
            <a class="link-underline" href="/collections/<%= product.collection.slug %>">More from <%= product.collection.name %></a>
          </div>
          <div class="product-grid product-grid--4">
            <% relatedProducts.forEach(function (p, i) { %>
              <%- include('partials/product-card', { product: p, delay: Math.min(i + 1, 4) }) %>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>
  </main>

  <!-- ─── Sticky mobile purchase bar ──────────────────────────────────── -->
  <div class="buy-bar">
    <div class="buy-bar__info">
      <div class="buy-bar__name"><%= product.title %></div>
      <div class="buy-bar__price">$<%= product.priceLabel %></div>
    </div>
    <% if (product.inStock && session && session.userId) { %>
      <form action="/add-to-cart" method="POST" data-cart-form>
        <input type="hidden" name="product_id" value="<%= product.id %>">
        <input type="hidden" name="quantity" value="1">
        <button class="btn btn--primary" type="submit">Add to Cart</button>
      </form>
    <% } else if (product.inStock) { %>
      <a class="btn btn--primary" href="/login">Sign in</a>
    <% } else { %>
      <span class="btn btn--ghost" aria-disabled="true">Sold Out</span>
    <% } %>
  </div>

  <%- include('partials/footer') %>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Your Cart' }) %>
</head>
<body>
  <%- include('partials/header') %>

  <main id="main">
    <section class="page-head">
      <div class="wrap-wide">
        <nav class="crumbs reveal" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><span>Cart</span>
        </nav>
        <h1 class="h1 reveal">Your cart</h1>
        <% if (cartItems.length > 0) { %>
          <p class="lede reveal" data-delay="1">
            <%= cartItems.length %> <%= cartItems.length === 1 ? 'piece' : 'pieces' %> held for you.
            Nothing is reserved until the order is placed.
          </p>
        <% } %>
      </div>
    </section>

    <% if (cartItems.length > 0) { %>
      <section class="section section--tight">
        <div class="wrap-wide cart">

          <div>
            <% cartItems.forEach(function (item) { %>
              <div class="cart-line reveal">
                <a class="cart-line__media" href="<%= item.href %>" aria-label="<%= item.title %>">
                  <%- catalog.productArt(item, { ratio: 'portrait' }) %>
                </a>

                <div>
                  <h2 class="cart-line__name"><a href="<%= item.href %>"><%= item.title %></a></h2>
                  <p class="cart-line__meta" style="margin-bottom:0.5rem">
                    <%= item.category %> · Qty <%= item.quantity %> · $<%= item.priceLabel %> each
                  </p>
                  <span class="stock-pill <%= item.stockStatus === 'In Stock' ? '' : 'stock-pill--out' %>">
                    <%= item.stockStatus %>
                  </span>
                </div>

                <div class="cart-line__right">
                  <span class="cart-line__price">$<%= catalog.formatPrice(item.totalPrice) %></span>
                  <form action="/remove-from-cart" method="POST">
                    <input type="hidden" name="product_id" value="<%= item.product_id %>">
                    <button class="cart-line__remove" type="submit">Remove</button>
                  </form>
                </div>
              </div>
            <% }) %>

            <p class="small muted" style="margin-top:2rem">
              Need to change a quantity? <a href="/add-to-cart" style="text-decoration:underline;text-underline-offset:3px">Adjust your cart</a>.
            </p>
          </div>

          <aside class="summary reveal" data-delay="1">
            <h3>Order summary</h3>

            <div class="summary__row">
              <span>Subtotal</span>
              <span>$<%= catalog.formatPrice(totalPrice) %></span>
            </div>
            <div class="summary__row">
              <span>Delivery</span>
              <span><%= shipping === 0 ? 'Complimentary' : '$' + catalog.formatPrice(shipping) %></span>
            </div>
            <div class="summary__row">
              <span>Taxes</span>
              <span class="muted">Calculated at checkout</span>
            </div>
            <div class="summary__row summary__row--total">
              <span>Total</span>
              <strong>$<%= catalog.formatPrice(grandTotal) %></strong>
            </div>

            <% if (shipping > 0) { %>
              <p class="tiny muted" style="margin-top:1rem">
                Add $<%= catalog.formatPrice(freeThreshold - totalPrice) %> for complimentary delivery.
              </p>
            <% } %>

            <a class="btn btn--primary btn--block btn--lg" href="/checkout">Proceed to Checkout</a>

            <a class="btn btn--ghost btn--block" href="/shop" style="margin-top:0.75rem">Continue Shopping</a>

            <div class="assurances" style="margin:1.5rem 0 0;border-bottom:0;padding-bottom:0">
              <p class="assurance">
                <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M10 2.5l6 2.5v5c0 3.6-2.5 6.6-6 7.5-3.5-.9-6-3.9-6-7.5V5z" stroke-linejoin="round"/><path d="M7.5 10l1.8 1.8L13 8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Secure checkout
              </p>
              <p class="assurance">
                <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 10a7 7 0 1 1 2.5 5.4" stroke-linecap="round"/><path d="M3 6v4h4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                30-day returns
              </p>
            </div>
          </aside>

        </div>
      </section>
    <% } else { %>
      <section class="section">
        <div class="wrap notice">
          <div class="notice__inner">
            <div class="notice__icon">
              <svg width="26" height="26" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
                <path d="M4 6h12l-1.1 9.2a1.5 1.5 0 0 1-1.5 1.3H6.6a1.5 1.5 0 0 1-1.5-1.3z" stroke-linejoin="round"/>
                <path d="M7.4 6a2.6 2.6 0 0 1 5.2 0" stroke-linecap="round"/>
              </svg>
            </div>
            <h2 class="h2">Your cart is empty</h2>
            <p class="lede">Nothing here yet. The collection is a good place to start.</p>
            <div class="notice__actions">
              <a class="btn btn--primary" href="/shop">Browse the collection</a>
              <a class="btn btn--ghost" href="/wishlist">View wishlist</a>
            </div>
          </div>
        </div>
      </section>
    <% } %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Objects for Considered Living' }) %>
</head>
<body>
  <%- include('partials/header') %>

  <main id="main">

    <!-- ─── Hero ─────────────────────────────────────────────────────── -->
    <section class="hero">
      <div class="hero__media"><%- catalog.sceneArt('sage', 0, 'wide') %></div>
      <div class="wrap-wide hero__inner">
        <div class="hero__content">
          <span class="eyebrow reveal">The <%= new Date().getMonth() < 6 ? 'Spring' : 'Autumn' %> Collection</span>
          <h1 class="display reveal" data-delay="1">Things worth<br><em class="serif-italic">keeping</em>.</h1>
          <p class="lede reveal" data-delay="2">
            We make a small number of pieces each year and we make them properly:
            honest materials, patient construction, and nothing added for the sake of it.
          </p>
          <div class="hero__actions reveal" data-delay="3">
            <a class="btn btn--dark btn--lg" href="/shop">Explore Collection</a>
            <a class="link-underline link-arrow" href="/about">
              Our story
              <svg width="16" height="10" viewBox="0 0 16 10" fill="none" stroke="currentColor" stroke-width="1.3">
                <path d="M1 5h13M10 1l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
      <div class="hero__meta">
        <p class="tiny muted">Est. <%= catalog.brand.since %><br><%= catalog.brand.city %></p>
      </div>
    </section>

    <!-- ─── Featured collections ─────────────────────────────────────── -->
    <section class="section">
      <div class="wrap-wide">
        <div class="section-head reveal">
          <div class="section-head__text">
            <span class="eyebrow">Collections</span>
            <h2 class="h2">Four ways to live with less</h2>
            <p class="lede">Each edit is built around a room, a routine, or a habit, not a category.</p>
          </div>
          <a class="link-underline" href="/collections">View all</a>
        </div>

        <div class="collection-grid collection-grid--featured">
          <% featuredCollections.forEach(function (c, i) { %>
            <a class="collection-card reveal" data-delay="<%= Math.min(i + 1, 4) %>" href="/collections/<%= c.slug %>">
              <div class="collection-card__media"><%- catalog.sceneArt(c.tone, i, i === 0 ? 'wide' : 'portrait') %></div>
              <div class="collection-card__body">
                <span class="collection-card__count"><%= c.count %> <%= c.count === 1 ? 'piece' : 'pieces' %></span>
                <h3><%= c.name %></h3>
                <span class="collection-card__cta">
                  Explore
                  <svg width="14" height="9" viewBox="0 0 16 10" fill="none" stroke="currentColor" stroke-width="1.3">
                    <path d="M1 5h13M10 1l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ─── Best sellers ─────────────────────────────────────────────── -->
    <section class="section section--cream">
      <div class="wrap-wide">
        <div class="section-head reveal">
          <div class="section-head__text">
            <span class="eyebrow">Most Loved</span>
            <h2 class="h2">Best sellers</h2>
          </div>
          <a class="link-underline" href="/shop?sort=rating">Shop all</a>
        </div>

        <div class="product-grid">
          <% bestSellers.forEach(function (product, i) { %>
            <%- include('partials/product-card', { product: product, delay: Math.min(i % 4 + 1, 4) }) %>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ─── Brand story ──────────────────────────────────────────────── -->
    <section class="section">
      <div class="wrap-wide">
        <div class="editorial">
          <div class="editorial__media reveal"><%- catalog.sceneArt('clay', 1, 'portrait') %></div>
          <div class="editorial__body reveal" data-delay="1">
            <span class="eyebrow">Our Philosophy</span>
            <h2 class="h2">The opposite of<br><em class="serif-italic">disposable</em></h2>
            <p class="lede">
              We start from the end: what will this look like in ten years? That single question
              rules out most materials, most finishes, and almost every shortcut.
            </p>
            <p class="muted">
              What survives is a short list of pieces made by people we know, in workshops we visit,
              from materials that improve rather than degrade. It means we release less. We think
              that is the point.
            </p>
            <div class="pillars">
              <div class="pillar">
                <span class="pillar__n">01</span>
                <h4>Materials first</h4>
                <p>Solid oak, veg-tanned leather, undyed cloth. Nothing that pretends to be something else.</p>
              </div>
              <div class="pillar">
                <span class="pillar__n">02</span>
                <h4>Made to be repaired</h4>
                <p>Joined, stitched, and fastened so a worn part can be replaced instead of the whole.</p>
              </div>
              <div class="pillar">
                <span class="pillar__n">03</span>
                <h4>Quietly designed</h4>
                <p>No logos on the outside. The piece should suit your room, not announce ours.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── New arrivals ─────────────────────────────────────────────── -->
    <section class="section section--tight">
      <div class="wrap-wide">
        <div class="section-head reveal">
          <div class="section-head__text">
            <span class="eyebrow">Just In</span>
            <h2 class="h2">New arrivals</h2>
          </div>
          <a class="link-underline" href="/new-arrivals">See everything new</a>
        </div>

        <div class="product-grid product-grid--4">
          <% newArrivals.forEach(function (product, i) { %>
            <%- include('partials/product-card', { product: product, delay: Math.min(i + 1, 4) }) %>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ─── Editorial feature ────────────────────────────────────────── -->
    <section class="section">
      <div class="wrap-wide">
        <article class="feature reveal">
          <div class="feature__media"><%- catalog.sceneArt('stone', 2, 'wide') %></div>
          <div class="feature__body">
            <span class="eyebrow eyebrow--light">The Journal · Issue 14</span>
            <h2 class="h2">A house on the coast, and the year nobody left</h2>
            <p>
              We spent three days with the joiner who makes our dining tables, in a workshop that
              has stood on the same stretch of coastline for four generations. What we learned about
              patience had very little to do with furniture.
            </p>
            <a class="btn btn--light" href="/about">Read the story</a>
          </div>
        </article>
      </div>
    </section>

    <!-- ─── Testimonials ─────────────────────────────────────────────── -->
    <section class="section section--beige">
      <div class="wrap-wide">
        <div class="section-head reveal">
          <div class="section-head__text">
            <span class="eyebrow">Words</span>
            <h2 class="h2">From our customers</h2>
          </div>
        </div>
        <div class="quotes">
          <% testimonials.forEach(function (t, i) { %>
            <figure class="quote reveal" data-delay="<%= i + 1 %>" style="margin:0">
              <div class="quote__stars" aria-label="5 out of 5">
                <% for (var s = 0; s < 5; s++) { %>
                  <svg width="13" height="13" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                    <path d="M6 .8l1.6 3.3 3.6.5-2.6 2.5.6 3.6L6 9l-3.2 1.7.6-3.6L.8 4.6l3.6-.5z"/>
                  </svg>
                <% } %>
              </div>
              <blockquote class="quote__text" style="margin:0">&ldquo;<%= t.text %>&rdquo;</blockquote>
              <figcaption class="quote__by"><%= t.by %> · <%= t.place %></figcaption>
            </figure>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ─── Newsletter ───────────────────────────────────────────────── -->
    <section class="section section--dark">
      <div class="wrap-slim newsletter reveal">
        <span class="eyebrow eyebrow--light">Join the community</span>
        <h2 class="h2">Letters, occasionally</h2>
        <p class="lede">
          A note when something new is finished, and a little on how it was made.
          Roughly once a month, never more.
        </p>
        <form class="newsletter__form" action="/shop" method="GET">
          <label class="visually-hidden" for="newsletter-email">Email address</label>
          <input class="input" type="email" id="newsletter-email" name="email" placeholder="Your email address" required>
          <button class="btn btn--light" type="submit">Subscribe</button>
        </form>
        <p class="newsletter__note">No noise, no resale of your details. Unsubscribe in one click.</p>
      </div>
    </section>

  </main>

  <%- include('partials/footer') %>
</body>
</html>

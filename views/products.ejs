<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: pageTitle }) %>
</head>
<body>
  <%- include('partials/header') %>

  <main id="main">
    <section class="page-head">
      <div class="wrap-wide">
        <nav class="crumbs reveal" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><span><%= pageTitle %></span>
        </nav>
        <span class="eyebrow reveal"><%= eyebrow %></span>
        <h1 class="h1 reveal" data-delay="1"><%= pageTitle %></h1>
        <p class="lede reveal" data-delay="2"><%= pageIntro %></p>
      </div>
    </section>

    <section class="section section--tight">
      <div class="wrap-wide shop">

        <!-- ─── Filters ─────────────────────────────────────────────── -->
        <aside class="filters" aria-label="Filters">
          <div class="filters__inner">
            <div class="filters__group">
              <h2 class="filters__title">Category</h2>
              <ul class="filters__list">
                <li>
                  <a class="<%= !activeCategory ? 'is-active' : '' %>" href="<%= buildUrl({ category: null }) %>">
                    <span>All pieces</span><span class="n"><%= totalCount %></span>
                  </a>
                </li>
                <% categories.forEach(function (c) { %>
                  <li>
                    <a class="<%= activeCategory === c.slug ? 'is-active' : '' %>" href="<%= buildUrl({ category: c.slug }) %>">
                      <span><%= c.name %></span><span class="n"><%= c.count %></span>
                    </a>
                  </li>
                <% }) %>
              </ul>
            </div>

            <div class="filters__group">
              <h2 class="filters__title">Collection</h2>
              <ul class="filters__list">
                <% catalog.collections.forEach(function (c) { %>
                  <li><a href="/collections/<%= c.slug %>"><span><%= c.name %></span></a></li>
                <% }) %>
              </ul>
            </div>

            <div class="filters__group">
              <h2 class="filters__title">Shortcuts</h2>
              <ul class="filters__list">
                <li><a href="/new-arrivals"><span>New arrivals</span></a></li>
                <li><a href="<%= buildUrl({ sort: 'price-asc' }) %>"><span>Price: low to high</span></a></li>
                <li><a href="<%= buildUrl({ sort: 'rating' }) %>"><span>Highest rated</span></a></li>
              </ul>
            </div>
          </div>
        </aside>

        <!-- ─── Results ─────────────────────────────────────────────── -->
        <div>
          <div class="toolbar">
            <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
              <button class="btn btn--ghost btn--sm filters-toggle" type="button" data-filters-toggle aria-expanded="false">
                Filters
              </button>
              <p class="toolbar__count">
                <%= products.length %> <%= products.length === 1 ? 'piece' : 'pieces' %><% if (query) { %> for &ldquo;<%= query %>&rdquo;<% } %>
              </p>
            </div>

            <div class="toolbar__sort">
              <label class="visually-hidden" for="sort">Sort by</label>
              <select class="select" id="sort" data-sort>
                <option value=""           <%= sort === ''           ? 'selected' : '' %>>Featured</option>
                <option value="new"        <%= sort === 'new'        ? 'selected' : '' %>>Newest</option>
                <option value="price-asc"  <%= sort === 'price-asc'  ? 'selected' : '' %>>Price: low to high</option>
                <option value="price-desc" <%= sort === 'price-desc' ? 'selected' : '' %>>Price: high to low</option>
                <option value="rating"     <%= sort === 'rating'     ? 'selected' : '' %>>Highest rated</option>
                <option value="name"       <%= sort === 'name'       ? 'selected' : '' %>>Alphabetical</option>
              </select>
            </div>
          </div>

          <% if (activeCategory || query) { %>
            <div class="chips" style="margin-bottom:2rem">
              <% if (activeCategory) { %>
                <a class="chip is-active" href="<%= buildUrl({ category: null }) %>">
                  <%= (categories.find(function (c) { return c.slug === activeCategory; }) || {}).name || activeCategory %>
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 2l6 6M8 2L2 8" stroke-linecap="round"/></svg>
                </a>
              <% } %>
              <% if (query) { %>
                <a class="chip is-active" href="<%= buildUrl({ q: null }) %>">
                  &ldquo;<%= query %>&rdquo;
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 2l6 6M8 2L2 8" stroke-linecap="round"/></svg>
                </a>
              <% } %>
            </div>
          <% } %>

          <% if (products.length > 0) { %>
            <div class="product-grid">
              <% products.forEach(function (product, i) { %>
                <%- include('partials/product-card', { product: product, delay: Math.min(i % 4 + 1, 4) }) %>
              <% }) %>
            </div>
          <% } else { %>
            <div class="notice" style="min-height:36vh">
              <div class="notice__inner">
                <div class="notice__icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                    <circle cx="11" cy="11" r="7"/><path d="M16.5 16.5L21 21" stroke-linecap="round"/>
                  </svg>
                </div>
                <h2 class="h3">Nothing here yet</h2>
                <p class="lede">We could not find a piece matching that. Try a broader search, or browse the full collection.</p>
                <div class="notice__actions">
                  <a class="btn btn--primary" href="/shop">View all pieces</a>
                </div>
              </div>
            </div>
          <% } %>
        </div>

      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>

<footer class="footer">
  <div class="wrap-wide">
    <div class="footer__top">
      <div>
        <a class="brand" href="/"><%= catalog.brand.name %></a>
        <p class="footer__about"><%= catalog.brand.tagline %> Made slowly in <%= catalog.brand.city %> since <%= catalog.brand.since %>.</p>
      </div>

      <div>
        <h2 class="footer__title">Shop</h2>
        <ul class="footer__list">
          <li><a href="/shop">All Pieces</a></li>
          <li><a href="/new-arrivals">New Arrivals</a></li>
          <% catalog.collections.slice(0, 3).forEach(function (c) { %>
            <li><a href="/collections/<%= c.slug %>"><%= c.name %></a></li>
          <% }) %>
        </ul>
      </div>

      <div>
        <h2 class="footer__title">Customer Care</h2>
        <ul class="footer__list">
          <li><a href="/display-cart">Your Cart</a></li>
          <li><a href="<%= session && session.userId ? '/dashboard' : '/login' %>">Your Account</a></li>
          <li><a href="/about#care">Shipping &amp; Returns</a></li>
          <li><a href="/about#care">Product Care</a></li>
        </ul>
      </div>

      <div>
        <h2 class="footer__title">About</h2>
        <ul class="footer__list">
          <li><a href="/about">Our Story</a></li>
          <li><a href="/about#materials">Materials</a></li>
          <li><a href="/about#craft">Craftsmanship</a></li>
          <li><a href="/collections">Collections</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; <%= year %> <%= catalog.brand.name %>. All rights reserved.</p>

      <div class="footer__social">
        <a href="/about" aria-label="Instagram">
          <svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
            <rect x="3" y="3" width="14" height="14" rx="4.2"/><circle cx="10" cy="10" r="3.4"/><circle cx="14.4" cy="5.6" r="0.9" fill="currentColor" stroke="none"/>
          </svg>
        </a>
        <a href="/about" aria-label="Pinterest">
          <svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
            <circle cx="10" cy="10" r="7.2"/><path d="M8.4 17l1.6-6.4M7.6 8.6c0-1.5 1.2-2.6 2.8-2.6s2.6 1 2.6 2.6c0 2-1.2 3.4-2.6 3.4-.8 0-1.4-.5-1.3-1.2" stroke-linecap="round"/>
          </svg>
        </a>
        <a href="/about" aria-label="Journal">
          <svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
            <path d="M4 4h9a3 3 0 0 1 3 3v9H7a3 3 0 0 1-3-3z" stroke-linejoin="round"/><path d="M7 8h6M7 11h4" stroke-linecap="round"/>
          </svg>
        </a>
      </div>

      <div class="footer__pay">
        <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
          <rect x="4" y="9" width="12" height="8" rx="2"/><path d="M7 9V6.5a3 3 0 0 1 6 0V9"/>
        </svg>
        <span>Visa</span><span>Mastercard</span><span>Amex</span><span>Secure</span>
      </div>
    </div>
  </div>
</footer>

<div class="toast-host" aria-live="polite"></div>
<script src="/js/app.js" defer></script>

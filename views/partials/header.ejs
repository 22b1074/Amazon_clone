<a class="skip-link" href="#main">Skip to content</a>

<div class="announce">Complimentary delivery over $150 &nbsp;·&nbsp; 30-day returns</div>

<header class="nav">
  <div class="wrap-wide nav__inner">
    <button class="icon-btn nav__toggle" type="button" data-menu-open aria-expanded="false" aria-label="Open menu">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
        <path d="M3 6h14M3 10h14M3 14h14"/>
      </svg>
    </button>

    <ul class="nav__links">
      <li><a class="nav__link <%= currentPath.startsWith('/shop') ? 'is-active' : '' %>" href="/shop">Shop</a></li>
      <li><a class="nav__link <%= currentPath.startsWith('/collections') ? 'is-active' : '' %>" href="/collections">Collections</a></li>
      <li><a class="nav__link <%= currentPath.startsWith('/new-arrivals') ? 'is-active' : '' %>" href="/new-arrivals">New Arrivals</a></li>
      <li><a class="nav__link <%= currentPath.startsWith('/about') ? 'is-active' : '' %>" href="/about">About</a></li>
    </ul>

    <a class="brand" href="/"><%= catalog.brand.name %></a>

    <div class="nav__actions">
      <button class="icon-btn" type="button" data-search-toggle aria-expanded="false" aria-controls="site-search" aria-label="Search">
        <svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4">
          <circle cx="9" cy="9" r="6"/><path d="M13.5 13.5L17 17" stroke-linecap="round"/>
        </svg>
      </button>

      <a class="icon-btn" href="/wishlist" aria-label="Wishlist">
        <svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="M10 16.5S3 12.6 3 7.9A3.9 3.9 0 0 1 10 5.6a3.9 3.9 0 0 1 7 2.3c0 4.7-7 8.6-7 8.6z" stroke-linejoin="round"/>
        </svg>
        <span class="icon-btn__badge" data-wish-count>0</span>
      </a>

      <a class="icon-btn" href="<%= session && session.userId ? '/dashboard' : '/login' %>"
         aria-label="<%= session && session.userId ? 'Account' : 'Sign in' %>">
        <svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4">
          <circle cx="10" cy="7" r="3.2"/><path d="M4 16.5c0-3 2.7-4.6 6-4.6s6 1.6 6 4.6" stroke-linecap="round"/>
        </svg>
      </a>

      <a class="icon-btn" href="/display-cart" aria-label="Cart">
        <svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="M4 6h12l-1.1 9.2a1.5 1.5 0 0 1-1.5 1.3H6.6a1.5 1.5 0 0 1-1.5-1.3z" stroke-linejoin="round"/>
          <path d="M7.4 6a2.6 2.6 0 0 1 5.2 0" stroke-linecap="round"/>
        </svg>
        <span class="icon-btn__badge <%= cartCount > 0 ? 'is-visible' : '' %>" data-cart-count><%= cartCount %></span>
      </a>
    </div>
  </div>

  <div class="searchbar" id="site-search">
    <div class="searchbar__inner">
      <div class="wrap-wide">
        <form action="/shop" method="GET" role="search">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" style="color:var(--ink-3);flex:none">
            <circle cx="9" cy="9" r="6"/><path d="M13.5 13.5L17 17" stroke-linecap="round"/>
          </svg>
          <label class="visually-hidden" for="q">Search products</label>
          <input class="input" type="search" id="q" name="q" placeholder="Search for a piece…"
                 value="<%= typeof query !== 'undefined' && query ? query : '' %>">
          <button class="btn btn--ghost btn--sm" type="submit">Search</button>
        </form>
      </div>
    </div>
  </div>
</header>

<nav class="menu" aria-hidden="true" aria-label="Mobile">
  <div class="menu__head">
    <a class="brand" href="/"><%= catalog.brand.name %></a>
    <button class="icon-btn" type="button" data-menu-close aria-label="Close menu">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
        <path d="M5 5l10 10M15 5L5 15"/>
      </svg>
    </button>
  </div>
  <ul class="menu__links">
    <li><a href="/shop">Shop</a></li>
    <li><a href="/collections">Collections</a></li>
    <li><a href="/new-arrivals">New Arrivals</a></li>
    <li><a href="/about">About</a></li>
    <li><a href="/wishlist">Wishlist</a></li>
    <li><a href="/display-cart">Cart<%= cartCount > 0 ? ' (' + cartCount + ')' : '' %></a></li>
    <% if (session && session.userId) { %>
      <li><a href="/dashboard">Account</a></li>
      <li><a href="/logout">Sign out</a></li>
    <% } else { %>
      <li><a href="/login">Sign in</a></li>
    <% } %>
  </ul>
</nav>
